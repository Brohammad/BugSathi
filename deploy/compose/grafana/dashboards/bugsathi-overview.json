  "panels": [
    {
      "title": "HTTP request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service, status) (rate(bugsathi_http_requests_total[1m]))",
          "legendFormat": "{{service}} {{status}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "HTTP error rate (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service, status) (rate(bugsathi_http_requests_total{status=~\"4xx|5xx\"}[1m]))",
          "legendFormat": "{{service}} {{status}}"
        }
      ]
    },
    {
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(bugsathi_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Outbox lag (pending)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "bugsathi_outbox_pending",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "title": "Pipeline jobs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (stage, result) (rate(bugsathi_pipeline_jobs_total[1m]))",
          "legendFormat": "{{stage}} {{result}}"
        }
      ]
    },
    {
      "title": "AI analyze latency p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(bugsathi_ai_analyze_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}}"
        }
      ]
    }
  ],
