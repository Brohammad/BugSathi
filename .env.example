# Copy to .env and adjust. Never commit .env.

APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bugsathi
POSTGRES_PASSWORD=bugsathi
POSTGRES_DB=bugsathi
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_MAX_CONN_LIFETIME=1h

# MinIO (S3 API)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=bugsathi
MINIO_SECRET_KEY=bugsathi_secret
MINIO_BUCKET=bugsathi
MINIO_USE_SSL=false

# Kafka-compatible (Redpanda)
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=bugsathi
KAFKA_RETRY_BASE=1s
KAFKA_RETRY_MAX=30s
KAFKA_RETRY_MAX_ATTEMPTS=5

# Comma-separated IPs/CIDRs that may set X-Forwarded-For (empty = never trust)
TRUSTED_PROXIES=

# Auth (JWT_SECRET must be >= 32 chars)
JWT_SECRET=dev-only-change-me-32chars-minimum!!
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h

# Media processing claim (WORKER_ID empty = hostname-pid)
WORKER_ID=
MEDIA_CLAIM_LEASE=2m
MEDIA_CLAIM_RENEW=30s

# AI (mock | openai)
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60s
AI_MAX_FRAMES=5

# Report detail cache (0 disables)
REPORT_CACHE_TTL=30s

# Share links (ADR 0028)
SHARE_DEFAULT_TTL=720h
SHARE_MAX_TTL=2160h
SHARE_HASH_TOKENS=true

# List pagination defaults
LIST_DEFAULT_LIMIT=50
LIST_MAX_LIMIT=100

# Observability (optional; leave empty to disable OTLP export)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_PPROF=false

# Browser UI (Vite). Empty disables CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
