# Production-like env for `make up-prod`. Copy to `.env.prod` and change secrets.
# Never commit `.env.prod`.

APP_ENV=production
LOG_LEVEL=info

API_HOST_PORT=8080
WORKER_HOST_PORT=8081

POSTGRES_USER=bugsathi
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=bugsathi
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h

MINIO_ACCESS_KEY=bugsathi
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=bugsathi

# JWT_SECRET must be >= 32 characters
JWT_SECRET=change-me-prod-jwt-secret-32chars-min!!
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h

AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60s
AI_MAX_FRAMES=5

# Media processing claim (ADR 0025). Keep the lease comfortably above the
# slowest expected ffmpeg run. Leave WORKER_ID empty (defaults to hostname-pid):
# replicas sharing one owner id would claim the same recording twice.
WORKER_ID=
MEDIA_CLAIM_LEASE=2m
MEDIA_CLAIM_RENEW=30s

REPORT_CACHE_TTL=30s
ENABLE_PPROF=false

# Production hardening (ADR 0022)
MAX_BODY_BYTES=1048576
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_RPS=5
AUTH_RATE_LIMIT_BURST=10
RATE_LIMIT_WINDOW=1m
KAFKA_RETRY_BASE=1s
KAFKA_RETRY_MAX=30s
KAFKA_RETRY_MAX_ATTEMPTS=5

# Optional observability (enable Compose profile `obs` + collector separately)
OTEL_EXPORTER_OTLP_ENDPOINT=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Browser UI origins (comma-separated; empty disables CORS)
CORS_ORIGINS=
